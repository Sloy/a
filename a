#!/usr/bin/env bash
#
# a: one entry point for the day-to-day adb chores — animation scales, font
# scale, screenshots, TalkBack and friends. Run it bare for an fzf menu, or
# pass the subcommand and its argument to skip every prompt.
#
# Each subcommand lives in its own script under commands/ and works standalone.
#
# AI DISCLOSURE: This script was entirely generated by an AI tool
set -uo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/common.sh"
source "$A_LIB/update.sh"

COMMANDS=(
  "animations|window, transition and animator scales"
  "screenshot|capture every device to ~/Downloads"
  "record|record the screen to ~/Downloads"
  "touch-pointer|show or hide the touch indicators"
  "font-size|system font scale"
  "talkback|accessibility screen reader"
  "navigation|gesture or three-button nav bar"
  "paste|type the clipboard into the device"
  "current-activity|print the foreground activity class"
  "fix-date|sync the emulator clock to the host"
  "update|pull the newest version of a"
)

usage() {
  local entry name desc
  printf 'a — android adb helpers\n\n'
  printf 'Usage: a [command] [argument]\n\n'
  printf 'Commands:\n'
  for entry in "${COMMANDS[@]}"; do
    name="${entry%%|*}"
    desc="${entry#*|}"
    printf '  %-16s %s\n' "$name" "$desc"
  done
  cat <<'USAGE'

Run `a` with no arguments to pick interactively; every prompt prints the
equivalent one-liner so you can skip it next time. Run `a <command> --help`
for that command's arguments.

Examples:
  a screenshot now
  a screenshot 5
  a record
  a font-size 1.15
  a animations off
  a talkback toggle
  a current-activity
  a update
USAGE
}

# Maps the loose spellings worth supporting onto a script name under commands/.
canonical() {
  local raw
  raw="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -d '_-')"
  case "$raw" in
    animations|animation|anim)            printf 'animations' ;;
    screenshot|screenshots|shot|ss)       printf 'screenshot' ;;
    record|rec|recording|video|screenrecord) printf 'record' ;;
    touchpointer|touch|touches|pointer)   printf 'touch-pointer' ;;
    fontsize|font|fontscale)              printf 'font-size' ;;
    talkback|tb)                          printf 'talkback' ;;
    navigation|nav|navbar)                printf 'navigation' ;;
    paste|clipboard)                      printf 'paste' ;;
    currentactivity|activity|topactivity|currentfocus)
                                          printf 'current-activity' ;;
    fixdate|date|fixemulatordate)         printf 'fix-date' ;;
    update|upgrade|selfupdate)            printf 'update' ;;
    *) return 1 ;;
  esac
}

[[ "${1:-}" =~ ^(update|upgrade|self-?update)$ ]] || check_for_updates

if [[ $# -eq 0 ]]; then
  pick "Android" "${COMMANDS[@]}"
  exec "$A_COMMANDS/$PICK_RESULT.sh"
fi

case "$1" in
  -h|--help|help) usage; exit 0 ;;
esac

if ! name="$(canonical "$1")"; then
  log "a: unknown command '$1'"
  usage >&2
  exit 1
fi
shift

exec "$A_COMMANDS/$name.sh" "$@"
